generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum CustomerStatus {
  Active
  Inactive
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  USER
  DRIVER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum TruckStatus {
  NO_ALLOTMENT // Loaded in warehouse, no driver assigned
  READY        // Driver assigned, ready to depart
  ACTIVE       // Actively moving on the road
  INACTIVE     // Under repair / maintenance
}

// ==========================================
// MODELS
// ==========================================

// 1. User Model
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatSessions ChatSession[]
  driver       Driver?
}

// 2. Customer Model (Module 1)
model Customer {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  company   String
  status    CustomerStatus @default(Active)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  shipments Shipment[]
}

// 3. Driver Model — linked 1:1 to a User account
model Driver {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String
  address       String
  photoUrl      String?
  licenseNumber String   @unique
  isOnDuty      Boolean  @default(true)
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  truck Truck? // one driver can be assigned to at most one truck at a time
}

// 4. Truck Model
model Truck {
  id          String      @id @default(uuid())
  name        String
  plateNumber String      @unique
  capacity    Int         @default(20)
  status      TruckStatus @default(NO_ALLOTMENT)
  driverId    String?     @unique
  driver      Driver?     @relation(fields: [driverId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shipments Shipment[]
}

// 5. Shipment Model (Module 1) — now optionally linked to a Truck
model Shipment {
  id             String         @id @default(uuid())
  trackingNumber String         @unique
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  origin         String
  destination    String
  status         ShipmentStatus @default(PENDING)
  truckId        String?
  truck          Truck?         @relation(fields: [truckId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  statusHistory ShipmentStatusHistory[]
}

// 6. Shipment Status History (Module 5 Audit Log)
model ShipmentStatusHistory {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  updatedAt  DateTime       @default(now())
}

// 7. Sales Data Model (Module 3)
model SalesRecord {
  id          String   @id @default(uuid())
  salesperson String
  revenue     Float
  region      String
  createdAt   DateTime @default(now())
}

// 8. AI Conversation Context Models (Module 4)
model ChatSession {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
}

// 9. Announcement Model (Bonus 3)
model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}