{
	"info": {
		"_postman_id": "shipment-mgmt-api-collection",
		"name": "Shipment Management System API",
		"description": "Complete collection for testing Auth, Customer, and Shipment APIs with auto-token management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerId",
			"value": "",
			"type": "string"
		},
		{
			"key": "shipmentId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. System Health",
			"item": [
				{
					"name": "Root Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				},
				{
					"name": "Database Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					}
				}
			]
		},
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alex Turner\",\n  \"email\": \"alex.turner@example.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "1.2 Login (Auto-saves Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.token);",
									"    console.log(\"Saved JWT Token to collection variable 'token'\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alex.turner@example.com\",\n  \"password\": \"securePassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "1.3 Get My Profile (Protected)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Customer Management",
			"item": [
				{
					"name": "2.1 Create Customer (Protected)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"customerId\", jsonData.data.id);",
									"    console.log(\"Saved customerId: \" + jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Nexus Retailers\",\n  \"email\": \"contact@nexusretail.com\",\n  \"company\": \"Nexus Global Corp\",\n  \"status\": \"Active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"]
						}
					}
				},
				{
					"name": "2.2 Get Customers List (Paginated & Filterable)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers?page=1&limit=10&status=Active",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "status", "value": "Active" }
							]
						}
					}
				},
				{
					"name": "2.3 Get Customer By ID (with Shipments)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				},
				{
					"name": "2.4 Update Customer (Protected)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"company\": \"Nexus Global Enterprise LLC\",\n  \"status\": \"Active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				},
				{
					"name": "2.5 Soft Delete Customer (Protected)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				}
			]
		},
		{
			"name": "3. Shipment Management",
			"item": [
				{
					"name": "3.1 Create Shipment (Protected)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"shipmentId\", jsonData.data.id);",
									"    console.log(\"Saved shipmentId: \" + jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"trackingNumber\": \"TRK-987654\",\n  \"customerId\": \"{{customerId}}\",\n  \"origin\": \"Seattle, WA\",\n  \"destination\": \"Austin, TX\",\n  \"status\": \"PENDING\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/shipments",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shipments"]
						}
					}
				},
				{
					"name": "3.2 Get Shipments List",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/shipments",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shipments"]
						}
					}
				},
				{
					"name": "3.3 Get Shipment By ID (with Audit History)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/shipments/{{shipmentId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shipments", "{{shipmentId}}"]
						}
					}
				},
				{
					"name": "3.4 Update Shipment Status (Protected)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/shipments/{{shipmentId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shipments", "{{shipmentId}}", "status"]
						}
					}
				}
			]
		}
	]
}
